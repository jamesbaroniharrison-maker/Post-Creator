# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Free-tier APIs used for research + photo captioning only (spec Â§5, CLAUDE.md hard rules).
# Nothing sensitive of yours passes through these calls.
# Gemini's google_search grounding tool needs billing enabled even on the free tier
# (confirmed via a live 429 on first call), so it's not usable for research as-is.
# Kept configured for photo-captioning (level 6) and as a summarizer paired with Tavily.
GEMINI_API_KEY=
# gemini-3.7-flash's free tier is capped at 20 requests/day - nowhere near enough for
# daily scoring (30-70 calls/day at current query volume), confirmed via a live 429
# after ~20 calls. gemini-flash-lite-latest survived a 25-call burst test with zero
# failures, so it's the default.
GEMINI_MODEL=gemini-flash-lite-latest
# Tavily: search API built for feeding LLMs, actually free (1000 searches/month, no
# billing needed). This is what performs the real web search for research (level 4/5).
# A monthly usage counter (usage_tracking.py) stops new searches at 900/month, leaving
# headroom under the cap rather than finding out mid-month via a hard failure.
TAVILY_API_KEY=

# Self-hosted Ollama endpoint used for all drafting calls by default (voice profile +
# your raw notes pass through this one — stays self-hosted unless DRAFT_LLM_PROVIDER
# below is switched to gemini).
OLLAMA_BASE_URL=http://localhost:11434
# llama3.2 (3B) followed structured-output instructions unreliably during voice-profile
# testing - it echoed back schema placeholder text instead of real analysis. llama3 (8B)
# did not have this problem, so it's the default despite being the larger download.
OLLAMA_MODEL=llama3

# Which model handles the main drafting call: "ollama" (default, free/local) or
# "gemini" (uses GEMINI_API_KEY/GEMINI_DRAFT_MODEL below). The privacy/PII scrub call
# always stays on Ollama regardless of this setting.
DRAFT_LLM_PROVIDER=ollama
# Only used when DRAFT_LLM_PROVIDER=gemini. Two models tried and rejected before this
# one, confirmed live: "gemini-pro-latest" (= gemini-3.1-pro) has a hard 0 free-tier
# quota - billing-gated, same as the research grounding tool. "gemini-flash-latest"
# (= gemini-3.8-flash) is noticeably better quality but burns heavy internal-reasoning
# tokens per call (~40s even for a trivial prompt) and hit the same "20 requests/day"
# free-tier wall as the old gemini-3.7-flash scoring model once did - confirmed live,
# 3 consecutive 429s a minute apart, so it's a real daily cap, not a per-minute one.
# gemini-flash-lite-latest (same model research scoring already relies on) is the
# default here too - proven to survive real volume, at some cost to drafting quality
# vs. flash-latest.
GEMINI_DRAFT_MODEL=gemini-flash-lite-latest

# Local SQLite path (matches rxconfig.py db_url). Overridden by SUPABASE_DB_URL if/when
# the project moves to Postgres per spec Â§5.
DATABASE_URL=sqlite:///linkedin_content_engine.db
SUPABASE_DB_URL=

# Email (weekly personal-story reminder + Sunday post digest, requested after the
# original spec). Recommended: a dedicated Gmail account just for this, with an "App
# Password" generated under Google Account > Security > App Passwords (needs 2-Step
# Verification enabled first). Leave blank to leave both email jobs inert - they skip
# themselves cleanly rather than erroring, per email_engine/send.py.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Opening sharpening (drafting_engine/openings.py): after drafting, try sharper first
# lines built only from the post itself and keep one if it scores clearly higher. 0 = off.
SHARPEN_OPENINGS=1

# Voice pass (drafting_engine/voice_pass.py): one rewrite of the chosen draft into your
# voice, kept only if it passes every fact check and sounds clearly more like you.
# VOICE_PASS_MODEL is a comma-separated list tried in order, then the drafting model.
# gemini-3.8-flash is the best free model but ~20 requests/day and sometimes "busy" - one
# call per post fits; Gemma models have a much bigger free allowance. VOICE_PASS=0 = off.
VOICE_PASS=1
VOICE_PASS_MODEL=
# If a stronger GEMINI_DRAFT_MODEL runs out of free allowance, drafts fall back to this
# for the next hour instead of failing (or freezing - a used-up allowance can come back
# with retry-after of 7+ hours).
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# The fact/style check runs on this (default: GEMINI_MODEL), so it never uses up a
# stronger drafting model's allowance.
GEMINI_AUDIT_MODEL=
# Thinking level for full Gemini 3 Flash models (Lite is left alone). "low" ~10s per call;
# their default took ~75s for a one-word reply.
GEMINI_THINKING_LEVEL=low
# Best-of-N drafts another round if the best "sounds like you" score is below this (0-100).
DRAFT_VOICE_FLOOR=60
