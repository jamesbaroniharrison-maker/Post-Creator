# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Free-tier APIs used for research + photo captioning only (spec Â§5, CLAUDE.md hard rules).
# Nothing sensitive of yours passes through these calls.
# Gemini's google_search grounding tool needs billing enabled even on the free tier
# (confirmed via a live 429 on first call), so it's not usable for research as-is.
# Kept configured for photo-captioning (level 6) and as a summarizer paired with Tavily.
GEMINI_API_KEY=
# gemini-3.7-flash's free tier is capped at 20 requests/day - nowhere near enough for
# daily scoring (30-70 calls/day at current query volume), confirmed via a live 429
# after ~20 calls. gemini-flash-lite-latest survived a 25-call burst test with zero
# failures, so it's the default.
GEMINI_MODEL=gemini-flash-lite-latest
# Tavily: search API built for feeding LLMs, actually free (1000 searches/month, no
# billing needed). This is what performs the real web search for research (level 4/5).
# A monthly usage counter (usage_tracking.py) stops new searches at 900/month, leaving
# headroom under the cap rather than finding out mid-month via a hard failure.
TAVILY_API_KEY=

# Self-hosted Ollama endpoint used for all drafting calls by default (voice profile +
# your raw notes pass through this one — stays self-hosted unless DRAFT_LLM_PROVIDER
# below is switched to gemini).
OLLAMA_BASE_URL=http://localhost:11434
# llama3.2 (3B) followed structured-output instructions unreliably during voice-profile
# testing - it echoed back schema placeholder text instead of real analysis. llama3 (8B)
# did not have this problem, so it's the default despite being the larger download.
OLLAMA_MODEL=llama3

# Which model handles the main drafting call: "ollama" (default, free/local) or
# "gemini" (uses GEMINI_API_KEY/GEMINI_MODEL above - only switch this once you've
# confirmed it's covered by what you already pay for). The privacy/PII scrub call
# always stays on Ollama regardless of this setting.
DRAFT_LLM_PROVIDER=ollama

# Local SQLite path (matches rxconfig.py db_url). Overridden by SUPABASE_DB_URL if/when
# the project moves to Postgres per spec Â§5.
DATABASE_URL=sqlite:///linkedin_content_engine.db
SUPABASE_DB_URL=

# No separate auth secret needed - reflex-local-auth (level 7) signs sessions using
# Reflex's own internal app secret, not a configurable env var.

# Email (weekly personal-story reminder + Sunday post digest, requested after the
# original spec). Recommended: a dedicated Gmail account just for this, with an "App
# Password" generated under Google Account > Security > App Passwords (needs 2-Step
# Verification enabled first). Leave blank to leave both email jobs inert - they skip
# themselves cleanly rather than erroring, per email_engine/send.py.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
