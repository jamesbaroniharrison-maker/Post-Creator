{% import "_parts.j2" as p %}{{ p.slide_open() }}<div style="position:relative;height:600px;flex:0 0 600px"><img src="{{ photo }}" alt="" style="display:block;width:100%;height:100%;object-fit:cover;object-position:50% 32%;filter:saturate(0.85) sepia(0.08)"><span style="position:absolute;top:-10px;left:-10px;width:40px;height:40px;border-top:3px solid #9a7437;border-left:3px solid #9a7437"></span><span style="position:absolute;bottom:-10px;right:-10px;width:40px;height:40px;border-bottom:3px solid #9a7437;border-right:3px solid #9a7437"></span></div><div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:24px;"><span style="font-family:'Geist Mono',monospace;font-size:24px;letter-spacing:0.14em;color:#7d5c2a;white-space:nowrap">{{ s.label | upper }}</span>{{ p.headline(s.headline, s.headline_gold, 70) }}{{ p.body_line(s.line, 32) }}</div>{{ p.footer() }}</div>
