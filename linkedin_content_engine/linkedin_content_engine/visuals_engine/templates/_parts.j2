{#- Shared pieces of the Baroni post templates (copied from D:\Work\! Branding\Post Templates.dc.html).
    Every slide is 1080 wide; layout and colours are unchanged - only the words are filled in. #}

{% macro slide_open(bg="#f6f2e9", height=1350) -%}
<div class="slide" style="width:1080px;height:{{ height }}px;background:{{ bg }};padding:80px;display:flex;flex-direction:column;overflow:hidden;position:relative;font-family:'Geist',Arial,sans-serif;color:#1b1f1a">
{%- endmacro %}

{#- Top row: mono label on the left, a gold diamond or "02 / 05" on the right. nowrap fixes the
    label wrapping onto two lines that shows in the original PNG exports. #}
{% macro top_row(label, page=None) -%}
<div style="display:flex;justify-content:space-between;align-items:center;gap:24px"><span style="font-family:'Geist Mono',monospace;font-size:24px;letter-spacing:0.14em;color:#7d5c2a;white-space:nowrap">{{ label | upper }}</span>
{%- if page %}<span style="font-family:'Geist Mono',monospace;font-size:22px;letter-spacing:0.1em;color:#6b695f;white-space:nowrap">{{ page }}</span>
{%- else %}<span style="flex:0 0 16px;width:16px;height:16px;background:#9a7437;transform:rotate(45deg)"></span>{% endif %}</div>
{%- endmacro %}

{#- Headline: plain words, then the one gold italic payoff (brand "signature move"). #}
{% macro headline(text, gold, size, extra="") -%}
<h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:{{ size }}px;line-height:1.03;letter-spacing:-0.025em;margin:0;color:#1b1f1a;text-wrap:balance;{{ extra }}">{{ text }}{% if gold %} <em style="font-style:italic;color:#9a7437">{{ gold }}</em>{% endif %}</h1>
{%- endmacro %}

{% macro body_line(text, size=40) -%}
<p style="font-size:{{ size }}px;line-height:1.45;color:#4d4c43;margin:0;text-wrap:pretty;">{{ text }}</p>
{%- endmacro %}

{% macro footer(name="JAMES BARONI HARRISON") -%}
<div style="display:flex;justify-content:space-between;align-items:center;padding-top:32px;border-top:2px solid #d8d0bf"><img src="assets/baroni-lockup-horizontal-on-light.png" alt="Baroni Applied Intelligence" style="display:block;height:72px;width:auto"><span style="font-family:'Geist Mono',monospace;font-size:20px;letter-spacing:0.1em;color:#6b695f;white-space:nowrap">{{ name }}</span></div>
{%- endmacro %}

{#- Carousel footer: one progress segment per slide, current one gold. #}
{% macro progress(current, total) -%}
<div style="display:flex;align-items:center;gap:24px"><div style="flex:1;display:flex;gap:8px">
{%- for i in range(1, total + 1) %}<span style="flex:1;height:4px;background:{{ '#9a7437' if i == current else '#d8d0bf' }}"></span>{% endfor -%}
</div><span style="font-family:'Geist Mono',monospace;font-size:20px;letter-spacing:0.12em;color:#7d5c2a;white-space:nowrap">{{ 'END' if current == total else 'SWIPE →' }}</span></div>
{%- endmacro %}

{% macro numbered_rows(items, size=36, weight=500, pad=26) -%}
<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:0px;margin:40px 0">
{%- for item in items %}<div style="display:flex;gap:32px;align-items:baseline;padding:{{ pad }}px 0;border-top:2px solid #d8d0bf;{% if loop.last %}border-bottom:2px solid #d8d0bf{% endif %}"><span style="font-family:'Geist Mono',monospace;font-size:24px;letter-spacing:0.08em;color:#9a7437;">{{ '%02d' % loop.index }}</span><span style="font-size:{{ size }}px;line-height:1.3;font-weight:{{ weight }}">{{ item }}</span></div>{% endfor -%}
</div>
{%- endmacro %}

{#- Big "6h -> 40m" style number row. `before` is optional: a single number shows on its own. #}
{% macro big_number(before, after) -%}
<div style="display:flex;align-items:baseline;gap:28px;font-family:'Newsreader',serif;font-size:260px;line-height:0.9;letter-spacing:-0.04em;color:#1b1f1a">
{%- if before %}<span>{{ before }}</span><span style="font-family:'Geist Mono',monospace;font-size:72px;color:#9a7437;letter-spacing:0">→</span>{% endif %}<span style="font-style:italic;color:#9a7437">{{ after }}</span></div>
{%- endmacro %}

{% macro cta_block(headline_text, gold, button, small) -%}
<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:44px;align-items:center;text-align:center"><img src="assets/baroni-lockup-stacked-on-light.png" alt="Baroni Applied Intelligence" style="display:block;height:210px;width:auto">{{ headline(headline_text, gold, 96, "text-align:center") }}<div style="padding:26px 44px;border:2px solid #1b1f1a;font-size:34px;font-weight:500">{{ button }}</div><span style="font-family:'Geist Mono',monospace;font-size:20px;letter-spacing:0.12em;color:#6b695f;">{{ small | upper }}</span></div>
{%- endmacro %}
