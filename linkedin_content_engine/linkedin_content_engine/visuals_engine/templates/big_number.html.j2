{% import "_parts.j2" as p %}{{ p.slide_open() }}{{ p.top_row(s.label) }}<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:48px;">{{ p.big_number(s.before_value, s.after_value) }}{{ p.body_line(s.caption) }}{% if s.stats %}<div style="display:flex;border-top:2px solid #d8d0bf;border-bottom:2px solid #d8d0bf">{% for st in s.stats %}<div style="flex:1;padding:26px 0;{% if not loop.first %}padding-left:28px;border-left:2px solid #d8d0bf;{% endif %}display:flex;flex-direction:column;gap:8px"><span style="font-family:'Geist Mono',monospace;font-size:20px;letter-spacing:0.1em;color:#1b1f1a;">{{ st | upper }}</span></div>{% endfor %}</div>{% endif %}</div>{{ p.footer() }}</div>
