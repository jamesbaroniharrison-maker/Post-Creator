{% import "_parts.j2" as p %}{% set total = 5 %}
{{ p.slide_open() }}{{ p.top_row(s.label, "01 / 05") }}<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:40px;">{{ p.headline(s.headline, s.headline_gold, 120, "line-height:1.0") }}{{ p.body_line(s.subline) }}</div>{{ p.progress(1, total) }}</div>
{% for step in s.steps %}{% set n = loop.index %}
{{ p.slide_open() }}{{ p.top_row("STEP %02d" % n, "%02d / 05" % (n + 1)) }}<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:36px;"><span style="font-family:'Newsreader',serif;font-style:italic;font-size:220px;line-height:0.85;color:#9a7437">{{ '%02d' % n }}</span>{{ p.headline(step.name, None, 110) }}{{ p.body_line(step.line) }}</div>
{%- if n == 1 and s.you_bring %}<div style="padding:28px 32px;background:#ece6d8;margin-bottom:48px"><span style="font-family:'Geist Mono',monospace;font-size:20px;letter-spacing:0.14em;color:#7d5c2a;">YOU BRING</span><div style="font-size:32px;margin-top:10px;font-weight:500">{{ s.you_bring }}</div></div>
{%- elif n == 2 and s.strip %}<div style="display:flex;align-items:center;margin-bottom:48px">{% for box in s.strip %}{% set you = loop.index == s.strip_you %}{% if not loop.first %}<span style="flex:0 0 16px;height:2px;background:#d8d0bf"></span>{% endif %}<div style="flex:1;padding:20px 18px;border:2px solid {{ '#9a7437' if you else '#d8d0bf' }};background:{{ 'rgba(154,116,55,0.08)' if you else 'transparent' }}"><span style="font-family:'Geist Mono',monospace;font-size:18px;letter-spacing:0.06em;color:#9a7437;">{{ '%02d' % loop.index }}{% if you %} · YOU{% endif %}</span><div style="font-size:28px;font-weight:500;margin-top:6px">{{ box }}</div></div>{% endfor %}</div>
{%- elif n == 3 and s.dashboard %}<div style="background:#1b1f1a;padding:36px 40px;margin-bottom:48px"><div style="display:flex;justify-content:space-between;padding-bottom:18px"><span style="font-family:'Geist Mono',monospace;font-size:18px;letter-spacing:0.12em;color:#b4b0a2;">{{ (s.dashboard_title or 'RESULTS') | upper }}</span></div>{% for row in s.dashboard %}<div style="display:flex;justify-content:space-between;align-items:baseline;padding:16px 0;border-top:2px solid #353b33"><span style="font-family:'Geist Mono',monospace;font-size:22px;letter-spacing:0.1em;color:#ece7dc;">{{ row.label | upper }}</span><span style="font-family:'Newsreader',serif;font-size:46px;line-height:1;color:#d4a86a">{{ row.value }}</span></div>{% endfor %}</div>
{%- endif %}{{ p.progress(n + 1, total) }}</div>
{% endfor %}
{{ p.slide_open("#ece6d8") }}{{ p.top_row(s.cta_label or "YOUR TURN", "05 / 05") }}{{ p.cta_block(s.cta_headline, s.cta_gold, s.cta_button, s.cta_small) }}{{ p.progress(5, total) }}</div>
