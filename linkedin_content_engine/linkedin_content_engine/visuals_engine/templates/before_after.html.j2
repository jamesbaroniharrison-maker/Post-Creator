{% import "_parts.j2" as p %}{{ p.slide_open() }}{{ p.top_row(s.label) }}<div style="margin-top:56px">{{ p.headline(s.headline, s.headline_gold, 92) }}</div><div style="flex:1;display:grid;grid-template-columns:1fr 1fr;margin:56px 0 48px;border:2px solid #d8d0bf"><div style="padding:40px;display:flex;flex-direction:column;gap:26px"><span style="font-family:'Geist Mono',monospace;font-size:22px;letter-spacing:0.14em;color:#6b695f;">BEFORE</span>{% for line in s.before %}<div style="font-size:32px;line-height:1.3;color:#4d4c43;padding-top:24px;border-top:2px solid #d8d0bf">{{ line }}</div>{% endfor %}</div><div style="background:#1b1f1a;padding:40px;display:flex;flex-direction:column;gap:26px"><span style="font-family:'Geist Mono',monospace;font-size:22px;letter-spacing:0.14em;color:#d4a86a;">AFTER</span>{% for line in s.after %}<div style="font-size:32px;line-height:1.3;color:#ece7dc;padding-top:24px;border-top:2px solid #353b33">{{ line }}</div>{% endfor %}</div></div>{{ p.footer() }}</div>
