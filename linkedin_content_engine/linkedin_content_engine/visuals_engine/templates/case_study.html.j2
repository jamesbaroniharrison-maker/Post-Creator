{% import "_parts.j2" as p %}{% set total = 6 %}
{{ p.slide_open() }}{{ p.top_row(s.label, "01 / 06") }}<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:40px;">{{ p.headline(s.headline, s.headline_gold, 112, "line-height:1.0") }}{{ p.body_line(s.subline, 38) }}</div>{{ p.progress(1, total) }}</div>
{{ p.slide_open() }}{{ p.top_row("THE PROBLEM", "02 / 06") }}<div style="margin-top:56px">{{ p.headline(s.problem_headline, s.problem_gold, 88) }}</div>{{ p.numbered_rows(s.problems, 38, 400, 30) }}{{ p.progress(2, total) }}</div>
{{ p.slide_open() }}{{ p.top_row("THE BUILD", "03 / 06") }}<div style="margin-top:56px">{{ p.headline(s.build_headline, s.build_gold, 84) }}</div><div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:0px;margin:40px 0">{% for step in s.build_steps %}{% set you = loop.index == s.you_step %}<div style="display:grid;grid-template-columns:110px minmax(0,1fr);gap:16px;align-items:baseline;padding:22px 24px;border-top:2px solid {{ '#9a7437' if you else '#d8d0bf' }};{% if you %}background:#ece6d8;{% endif %}{% if loop.last %}border-bottom:2px solid #d8d0bf{% endif %}"><span style="font-family:'Geist Mono',monospace;font-size:20px;letter-spacing:0.06em;color:#9a7437;white-space:nowrap">{{ '%02d' % loop.index }}{% if you %} · YOU{% endif %}</span><div><div style="font-size:34px;font-weight:500">{{ step.name }}</div><div style="font-size:26px;color:#4d4c43;margin-top:4px">{{ step.desc }}</div></div></div>{% endfor %}</div>{{ p.progress(3, total) }}</div>
{{ p.slide_open() }}{{ p.top_row("THE RESULT", "04 / 06") }}<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:48px;">{{ p.big_number(s.before_value, s.after_value) }}{{ p.body_line(s.result_caption) }}{% if s.result_stats %}<div style="display:flex;border-top:2px solid #d8d0bf;border-bottom:2px solid #d8d0bf">{% for st in s.result_stats %}<div style="flex:1;padding:26px 0;{% if not loop.first %}padding-left:28px;border-left:2px solid #d8d0bf;{% endif %}display:flex;flex-direction:column;gap:8px"><span style="font-family:'Newsreader',serif;font-size:84px;line-height:1">{{ st.value }}</span><span style="font-family:'Geist Mono',monospace;font-size:20px;letter-spacing:0.1em;color:#6b695f;">{{ st.label | upper }}</span></div>{% endfor %}</div>{% endif %}</div>{{ p.progress(4, total) }}</div>
{{ p.slide_open() }}{{ p.top_row("THE LESSON", "05 / 06") }}<div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:44px;"><span style="width:72px;height:3px;background:#9a7437"></span>{{ p.headline(s.lesson, s.lesson_gold, 96) }}{{ p.body_line(s.lesson_line, 36) }}</div>{{ p.progress(5, total) }}</div>
{{ p.slide_open("#ece6d8") }}{{ p.top_row(s.cta_label or "YOUR TURN", "06 / 06") }}{{ p.cta_block(s.cta_headline, s.cta_gold, s.cta_button, s.cta_small) }}{{ p.progress(6, total) }}</div>
