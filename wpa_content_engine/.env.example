# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Free-tier APIs used for research + photo captioning only (spec Â§5, CLAUDE.md hard rules).
# Nothing sensitive of hers passes through these calls.
# Gemini's google_search grounding tool needs billing enabled even on the free tier
# (confirmed via a live 429 on first call), so it's not usable for research as-is.
# Kept configured for photo-captioning (level 6) and as a summarizer paired with Tavily.
GEMINI_API_KEY=
# Tavily: search API built for feeding LLMs, actually free (1000 searches/month, no
# billing needed). This is what performs the real web search for research (level 4/5).
TAVILY_API_KEY=

# Self-hosted Ollama endpoint used for all drafting calls (voice profile + her raw notes
# pass through this one — must stay self-hosted, never routed to a third-party API).
OLLAMA_BASE_URL=http://localhost:11434
# llama3.2 (3B) followed structured-output instructions unreliably during voice-profile
# testing - it echoed back schema placeholder text instead of real analysis. llama3 (8B)
# did not have this problem, so it's the default despite being the larger download.
OLLAMA_MODEL=llama3

# Local SQLite path (matches rxconfig.py db_url). Overridden by SUPABASE_DB_URL if/when
# the project moves to Postgres per spec Â§5.
DATABASE_URL=sqlite:///wpa_content_engine.db
SUPABASE_DB_URL=

# No separate auth secret needed - reflex-local-auth (level 7) signs sessions using
# Reflex's own internal app secret, not a configurable env var.
